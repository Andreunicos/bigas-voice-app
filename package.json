{
  "name": "bigas-voice-app",
  "version": "0.5.0",
  "description": "Bigas Voice — o mesmo site, num aplicativo que se atualiza sozinho.",
  "main": "main.js",
  "author": "Andreunicos",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "publicar": "electron-builder --publish always",
    "test": "node teste.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "electron": "^32.2.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.andreunicos.bigasvoice",
    "productName": "Bigas Voice",
    "compression": "maximum",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "home.html",
      "home.js",
      "seletor-de-tela.html",
      "seletor-de-tela.js",
      "icone.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "Andreunicos",
      "repo": "bigas-voice-app",
      "releaseType": "release"
    }
  }
}
